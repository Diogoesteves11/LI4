%% Diagrama de Classes — Subsistema de Utilizadores
%% Backend MobiFix (ASP.NET Core 8 / C#)
%% Referencia: Projeto-MobiFix/Backend/{Controllers,Services,Models}/Utilizadores
%%
%% Notas:
%%   - Nao existe ClienteController proprio: o fluxo de criacao de Cliente
%%     e exposto atraves do AuthController (endpoint register/cliente),
%%     por isso nesta vista apenas FuncionariosController aparece.
%%   - ClienteService tem apenas um metodo publico (consulta por NIF),
%%     usado por outros subsistemas para notificacoes e faturacao.

classDiagram
    direction LR

    class FuncionariosController {
        <<controller>>
        -_funcionarioService : IFuncionarioService
        +FuncionariosController(funcionarioService : IFuncionarioService)
        +CriarFuncionario(criacaoDto : FuncionarioCriacaoDto) Task~IActionResult~
        +ListarFuncionarios() Task~IActionResult~
        +ObterFuncionario(numeroMecanografico : string) Task~IActionResult~
        +AtualizarFuncionario(numeroMecanografico : string, atualizacaoDto : FuncionarioAtualizacaoDto) Task~IActionResult~
    }

    class IFuncionarioService {
        <<interface>>
        +CriarFuncionarioAsync(criacaoDto : FuncionarioCriacaoDto) Task~FuncionarioDto?~
        +ListarFuncionariosAsync() Task~IEnumerable~FuncionarioDto~~
        +ObterFuncionarioPorNumeroAsync(numeroMecanografico : string) Task~FuncionarioDto?~
        +AtualizarFuncionarioAsync(numeroMecanografico : string, atualizacaoDto : FuncionarioAtualizacaoDto) Task~FuncionarioDto?~
    }

    class FuncionarioService {
        <<service>>
        -_httpClient : HttpClient
        +FuncionarioService(httpClient : HttpClient)
        +CriarFuncionarioAsync(criacaoDto : FuncionarioCriacaoDto) Task~FuncionarioDto?~
        +ListarFuncionariosAsync() Task~IEnumerable~FuncionarioDto~~
        +ObterFuncionarioPorNumeroAsync(numeroMecanografico : string) Task~FuncionarioDto?~
        +AtualizarFuncionarioAsync(numeroMecanografico : string, atualizacaoDto : FuncionarioAtualizacaoDto) Task~FuncionarioDto?~
    }

    class IClienteService {
        <<interface>>
        +ObterPorNifAsync(nif : string) Task~ClienteDto?~
    }

    class ClienteService {
        <<service>>
        -_httpClient : HttpClient
        +ClienteService(httpClient : HttpClient)
        +ObterPorNifAsync(nif : string) Task~ClienteDto?~
    }

    class FuncionarioDto {
        <<DTO>>
        +NumeroMecanografico : string
        +Nome : string
        +Email : string
        +Contacto : string
        +Cargo : string
        +PasswordHash : string
        +Especialidade : string?
        +Ativo : bool
    }

    class FuncionarioCriacaoDto {
        <<DTO>>
        +NumeroMecanografico : string
        +Nome : string
        +Email : string
        +Contacto : string
        +Cargo : string
        +PasswordHash : string
        +Especialidade : string?
        +Ativo : bool
    }

    class FuncionarioAtualizacaoDto {
        <<DTO>>
        +Nome : string
        +Email : string
        +Contacto : string
        +Cargo : string
        +Especialidade : string?
        +Ativo : bool
    }

    class ClienteDto {
        <<DTO>>
        +NIF : string
        +Nome : string
        +Telefone : string
        +Email : string
        +Morada : string
        +PasswordHash : string
    }

    FuncionarioService       ..|> IFuncionarioService    : realiza
    ClienteService           ..|> IClienteService        : realiza
    FuncionariosController   ..>  IFuncionarioService    : injeta
    FuncionariosController   ..>  FuncionarioCriacaoDto
    FuncionariosController   ..>  FuncionarioAtualizacaoDto
    IFuncionarioService      ..>  FuncionarioDto
    IFuncionarioService      ..>  FuncionarioCriacaoDto
    IFuncionarioService      ..>  FuncionarioAtualizacaoDto
    IClienteService          ..>  ClienteDto
