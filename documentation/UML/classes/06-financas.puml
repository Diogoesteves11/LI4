@startuml Financas
' Diagrama de Classes — Subsistema de Financas
' Backend MobiFix (ASP.NET Core 8 / C#)
' Referencia: Projeto-MobiFix/Backend/{Controllers,Services,Models}/Financas
'
' O subsistema mais denso do projeto. Contem 5 agregados:
'   - Faturas (com Devolucoes + NotaCredito)
'   - Vendas  (com ItensVenda)
'   - EncomendaCliente  (com Itens)
'   - Estatisticas  (so agregacao, sem persistencia propria)
'   - Promocoes
'
' Dependencias cross-subsistema:
'   - Catalogos (IPecaService)
'   - Stocks    (IEncomendaStockService)
'   - Utilizadores (IClienteService)
'   - Email     (IEmailService)
'
' Dependencias internas ao subsistema:
'   - FaturaService depende de IVendaService, IEncomendaStockService
'   - EncomendaClienteService depende de IFaturaService, IPecaService

left to right direction
skinparam classAttributeIconSize 0
hide empty members

' =============== FATURAS ===============
class FaturasController <<controller>> {
    -_faturaService : IFaturaService
    +FaturasController(faturaService : IFaturaService)
    +Listar() : Task<IActionResult>
    +ObterFaturasCliente() : Task<IActionResult>
    +Obter(numero : string) : Task<IActionResult>
    +Criar(dto : FaturaCriacaoDto) : Task<IActionResult>
    +Eliminar(numero : string) : Task<IActionResult>
    +Devolver(numero : string, dto : DevolucaoCriacaoDto) : Task<IActionResult>
}

interface IFaturaService {
    +GetFaturasAsync() : Task<IEnumerable<FaturaDto>>
    +GetFaturasCliente(id : string) : Task<IEnumerable<FaturaDto>>
    +GetFaturaPorNumeroAsync(numero : string) : Task<FaturaDto?>
    +CriarFaturaAsync(faturaDto : FaturaCriacaoDto) : Task<FaturaDto?>
    +EliminarFaturaAsync(numero : string) : Task<bool>
    +ProcessarDevolucaoAsync(numeroFatura : string, motivo : string) : Task<FaturaDto?>
}

class FaturaService <<service>> {
    -_httpClient : HttpClient
    -_pecaService : IPecaService
    -_vendaService : IVendaService
    -_encomendaStockService : IEncomendaStockService
    -_clienteService : IClienteService
    -_emailService : IEmailService
    +FaturaService(httpClient : HttpClient, pecaService : IPecaService, vendaService : IVendaService, encomendaStockService : IEncomendaStockService, clienteService : IClienteService, emailService : IEmailService)
    +GetFaturasAsync() : Task<IEnumerable<FaturaDto>>
    +GetFaturasCliente(id : string) : Task<IEnumerable<FaturaDto>>
    +GetFaturaPorNumeroAsync(numero : string) : Task<FaturaDto?>
    +CriarFaturaAsync(faturaDto : FaturaCriacaoDto) : Task<FaturaDto?>
    +EliminarFaturaAsync(numero : string) : Task<bool>
    +ProcessarDevolucaoAsync(numeroFatura : string, motivo : string) : Task<FaturaDto?>
    -VerificarEReporStockAsync(peca : PecaDto) : Task
}

class FaturaDto <<DTO>> {
    +NumeroFatura : string
    +ClienteNIF : string
    +ServicoID : int?
    +VendaID : int?
    +ValorTotal : decimal
    +MetodoPagamento : string
    +DataEmissao : string?
    +Devolucoes : List<DevolucaoDto>
}

class DevolucaoDto <<DTO>> {
    +DevolucaoID : string?
    +DataDevolucao : string?
    +Motivo : string
    +NotaCredito : NotaCreditoDto?
}

class NotaCreditoDto <<DTO>> {
    +ValorCreditado : decimal
}

class DevolucaoCriacaoDto <<DTO>> {
    +Motivo : string
}

class FaturaCriacaoDto <<DTO>> {
    +NumeroFatura : string
    +ClienteNIF : string
    +ServicoID : int?
    +VendaID : int?
    +ValorTotal : decimal
    +MetodoPagamento : string
    +ItensVenda : List<ItemVendaCriacaoDto>
}

' =============== VENDAS ===============
class VendasController <<controller>> {
    -_vendaService : IVendaService
    +VendasController(vendaService : IVendaService)
    +Listar() : Task<IActionResult>
    +Obter(id : int) : Task<IActionResult>
    +RegistarVendaDireta(dto : CheckoutVendaDiretaDto) : Task<IActionResult>
}

interface IVendaService {
    +ListarVendasAsync() : Task<IEnumerable<VendaDto>>
    +ObterVendaAsync(id : int) : Task<VendaDto?>
    +RegistarVendaDiretaAsync(operadorNumero : string, dto : CheckoutVendaDiretaDto) : Task<VendaComFaturaDto?>
}

class VendaService <<service>> {
    -_httpClient : HttpClient
    -_pecaService : IPecaService
    -_encomendaStockService : IEncomendaStockService
    +VendaService(httpClient : HttpClient, pecaService : IPecaService, encomendaStockService : IEncomendaStockService)
    +ListarVendasAsync() : Task<IEnumerable<VendaDto>>
    +ObterVendaAsync(id : int) : Task<VendaDto?>
    +RegistarVendaDiretaAsync(operadorNumero : string, dto : CheckoutVendaDiretaDto) : Task<VendaComFaturaDto?>
    -VerificarEReporStockAsync(peca : PecaDto) : Task
}

class VendaDto <<DTO>> {
    +VendaID : int
    +OperadorNumero : string
    +DataVenda : string?
    +Total : decimal
    +ItensVenda : List<ItemVendaDto>
}

class ItemVendaDto <<DTO>> {
    +PecaEAN : string
    +Quantidade : int
}

class CheckoutVendaDiretaDto <<DTO>> {
    +NumeroFatura : string
    +ClienteNIF : string
    +OperadorNumero : string?
    +ValorTotal : decimal
    +MetodoPagamento : string
    +ItensVenda : List<ItemVendaCriacaoDto>
}

class ItemVendaCriacaoDto <<DTO>> {
    +PecaEAN : string
    +Quantidade : int
    +PrecoUnitario : decimal
}

class VendaComFaturaDto <<DTO>> {
    +Venda : VendaDto
    +Fatura : FaturaDto
}

' =============== ENCOMENDA CLIENTE ===============
class EncomendaClienteController <<controller>> {
    -_encomendaService : IEncomendaClienteService
    +EncomendaClienteController(encomendaService : IEncomendaClienteService)
    +ListarMinhasEncomendas() : Task<IActionResult>
    +CriarEncomenda(dto : EncomendaClienteCriacaoDto) : Task<IActionResult>
    +ListarProntas() : Task<IActionResult>
    +LevantarEncomenda(id : int, dto : LevantamentoEncomendaDto) : Task<IActionResult>
}

interface IEncomendaClienteService {
    +CriarEncomendaAsync(clienteNIF : string, dto : EncomendaClienteCriacaoDto) : Task<EncomendaClienteDto?>
    +ListarEncomendasClienteAsync(clienteNIF : string) : Task<IEnumerable<EncomendaClienteDto>>
    +ListarProntasParaLevantamentoAsync() : Task<IEnumerable<PecaReservadaDto>>
    +MarcarComoLevantadaAsync(id : int) : Task<bool>
    +LevantarComFaturaAsync(id : int, metodoPagamento : string) : Task<FaturaDto?>
}

class EncomendaClienteService <<service>> {
    -_httpClient : HttpClient
    -_faturaService : IFaturaService
    -_pecaService : IPecaService
    +EncomendaClienteService(httpClient : HttpClient, faturaService : IFaturaService, pecaService : IPecaService)
    +CriarEncomendaAsync(clienteNIF : string, dto : EncomendaClienteCriacaoDto) : Task<EncomendaClienteDto?>
    +ListarEncomendasClienteAsync(clienteNIF : string) : Task<IEnumerable<EncomendaClienteDto>>
    +ListarProntasParaLevantamentoAsync() : Task<IEnumerable<PecaReservadaDto>>
    +MarcarComoLevantadaAsync(id : int) : Task<bool>
    +LevantarComFaturaAsync(id : int, metodoPagamento : string) : Task<FaturaDto?>
}

class EncomendaClienteDto <<DTO>> {
    +EncomendaClienteID : int
    +ClienteNIF : string
    +DataEncomenda : string
    +Estado : string
    +Total : decimal
    +FaturaNumero : int?
    +Itens : List<ItemEncomendaDto>
}

class ItemEncomendaDto <<DTO>> {
    +PecaEAN : string
    +Quantidade : int
}

class EncomendaClienteCriacaoDto <<DTO>> {
    +Itens : List<ItemEncomendaCriacaoDto>
}

class ItemEncomendaCriacaoDto <<DTO>> {
    +PecaEAN : string
    +Quantidade : int
    +PrecoUnitario : decimal
}

class PecaReservadaDto <<DTO>> {
    +EncomendaClienteID : int
    +ClienteNIF : string
    +DataEncomenda : string
    +Estado : string
    +Total : decimal
    +Itens : List<ItemEncomendaDetalhadoDto>
}

class ItemEncomendaDetalhadoDto <<DTO>> {
    +PecaEAN : string
    +Nome : string?
    +Categoria : string?
    +Quantidade : int
    +PrecoUnitario : double?
}

class LevantamentoEncomendaDto <<DTO>> {
    +MetodoPagamento : string
}

' =============== ESTATISTICAS ===============
class EstatisticasController <<controller>> {
    -_service : IEstatisticasService
    +EstatisticasController(service : IEstatisticasService)
    +Get() : Task<ActionResult<EstatisticaDto>>
    +GetDia(dia : DateTime) : Task<ActionResult<EstatisticaDto>>
    +GetIntervalo(inicio : DateTime, fim : DateTime) : Task<ActionResult<EstatisticaDto>>
}

interface IEstatisticasService {
    +GetEstatisticaDiaAsync(dia : DateTime) : Task<EstatisticaDto>
    +GetIntervaloEstatisticaAsync(inicio : DateTime, fim : DateTime) : Task<EstatisticaDto>
    +GetEstatisticasAsync() : Task<EstatisticaDto>
}

class EstatisticasService <<service>> {
    -_httpClient : HttpClient
    +EstatisticasService(httpClient : HttpClient)
    +GetEstatisticaDiaAsync(dia : DateTime) : Task<EstatisticaDto>
    +GetIntervaloEstatisticaAsync(inicio : DateTime, fim : DateTime) : Task<EstatisticaDto>
    +GetEstatisticasAsync() : Task<EstatisticaDto>
    -ComporEstatisticaAsync(inicio : DateTime?, fim : DateTime?) : Task<EstatisticaDto>
}

class EstatisticaDto <<DTO>> {
    +TempoMedioServicoMinutos : double
    +FaturacaoTotal : decimal
    +FaturacaoServicos : decimal
    +FaturacaoVendas : decimal
    +Movimentacao : List<Faturacao>
    +NumeroAgendamentos : int
    +NumeroVendas : int
    +ServicosRealizados : int
    +Devolucoes : List<DevolucaoDto>
    +ValorTotalDevolucoes : decimal
}

class Faturacao <<DTO>> {
    +Categoria : string
    +Fatura : FaturaDto
    +Valor : decimal
}

' =============== PROMOCOES ===============
class PromocoesController <<controller>> {
    -_promocaoService : IPromocaoService
    +PromocoesController(promocaoService : IPromocaoService)
    +Listar() : Task<IActionResult>
    +Obter(id : string) : Task<IActionResult>
    +Criar(dto : PromocaoCriacaoDto) : Task<IActionResult>
    +Atualizar(id : string, dto : PromocaoDto) : Task<IActionResult>
    +AlterarEstado(id : string, request : AlterarEstadoRequest) : Task<IActionResult>
    +Eliminar(id : string) : Task<IActionResult>
}

interface IPromocaoService {
    +GetPromocoesAsync() : Task<IEnumerable<PromocaoDto>>
    +GetPromocaoPorIdAsync(id : string) : Task<PromocaoDto?>
    +CriarPromocaoAsync(dto : PromocaoCriacaoDto) : Task<PromocaoDto?>
    +AtualizarPromocaoAsync(id : string, dto : PromocaoDto) : Task<PromocaoDto?>
    +AlterarEstadoAsync(id : string, ativa : bool) : Task<PromocaoDto?>
    +EliminarPromocaoAsync(id : string) : Task<bool>
}

class PromocaoService <<service>> {
    -_httpClient : HttpClient
    +PromocaoService(httpClient : HttpClient)
    +GetPromocoesAsync() : Task<IEnumerable<PromocaoDto>>
    +GetPromocaoPorIdAsync(id : string) : Task<PromocaoDto?>
    +CriarPromocaoAsync(dto : PromocaoCriacaoDto) : Task<PromocaoDto?>
    +AtualizarPromocaoAsync(id : string, dto : PromocaoDto) : Task<PromocaoDto?>
    +AlterarEstadoAsync(id : string, ativa : bool) : Task<PromocaoDto?>
    +EliminarPromocaoAsync(id : string) : Task<bool>
}

class PromocaoDto <<DTO>> {
    +PromocaoID : int
    +Descricao : string
    +PercentagemDesconto : int
    +DataInicio : string
    +DataFim : string
    +AdministradorNumero : string
    +Ativa : bool
    +PecasAplicaveisEANs : List<string>
}

class PromocaoCriacaoDto <<DTO>> {
    +PromocaoID : int
    +Descricao : string
    +PercentagemDesconto : int
    +DataInicio : string
    +DataFim : string
    +AdministradorNumero : string
    +PecasAplicaveisEANs : List<string>
}

class AlterarEstadoRequest <<DTO>> {
    +Ativa : bool
}

' =============== EXTERNOS ===============
interface IPecaService <<external>>
interface IEncomendaStockService <<external>>
interface IClienteService <<external>>
interface IEmailService <<external>>
class PecaDto <<external>>

' =============== RELACOES ===============

' Realizacoes
FaturaService              ..|> IFaturaService              : realiza
VendaService               ..|> IVendaService               : realiza
EncomendaClienteService    ..|> IEncomendaClienteService    : realiza
EstatisticasService        ..|> IEstatisticasService        : realiza
PromocaoService            ..|> IPromocaoService            : realiza

' Injeccoes nos controllers
FaturasController           ..> IFaturaService           : injeta
VendasController            ..> IVendaService            : injeta
EncomendaClienteController  ..> IEncomendaClienteService : injeta
EstatisticasController      ..> IEstatisticasService     : injeta
PromocoesController         ..> IPromocaoService         : injeta

' Dependencias inter-subsistema
FaturaService            ..> IPecaService               : injeta
FaturaService            ..> IVendaService              : injeta
FaturaService            ..> IEncomendaStockService     : injeta
FaturaService            ..> IClienteService            : injeta
FaturaService            ..> IEmailService              : injeta
VendaService             ..> IPecaService               : injeta
VendaService             ..> IEncomendaStockService     : injeta
EncomendaClienteService  ..> IFaturaService             : injeta
EncomendaClienteService  ..> IPecaService               : injeta
FaturaService            ..> PecaDto                    : manipula
VendaService             ..> PecaDto                    : manipula

' Composicoes (sub-documentos)
FaturaDto            "1" *-- "0..*" DevolucaoDto             : devolucoes
DevolucaoDto         "1" *-- "0..1" NotaCreditoDto           : notaCredito
VendaDto             "1" *-- "1..*" ItemVendaDto             : itensVenda
EncomendaClienteDto  "1" *-- "1..*" ItemEncomendaDto         : itens
PecaReservadaDto     "1" *-- "1..*" ItemEncomendaDetalhadoDto : itens
EstatisticaDto       "1" *-- "0..*" Faturacao                : movimentacao
EstatisticaDto       "1" *-- "0..*" DevolucaoDto             : devolucoes

' Associacoes entre DTOs
VendaComFaturaDto --> "1" VendaDto  : contem
VendaComFaturaDto --> "1" FaturaDto : contem
Faturacao         --> "1" FaturaDto : referencia
FaturaCriacaoDto  --> "0..*" ItemVendaCriacaoDto : itensVenda
EncomendaClienteCriacaoDto --> "1..*" ItemEncomendaCriacaoDto : itens

' Dependencias assinaturas
FaturasController           ..> FaturaCriacaoDto
FaturasController           ..> DevolucaoCriacaoDto
VendasController            ..> CheckoutVendaDiretaDto
EncomendaClienteController  ..> EncomendaClienteCriacaoDto
EncomendaClienteController  ..> LevantamentoEncomendaDto
PromocoesController         ..> PromocaoCriacaoDto
PromocoesController         ..> PromocaoDto
PromocoesController         ..> AlterarEstadoRequest

@enduml
