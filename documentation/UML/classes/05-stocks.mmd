%% Diagrama de Classes — Subsistema de Stocks
%% Backend MobiFix (ASP.NET Core 8 / C#)
%% Referencia: Projeto-MobiFix/Backend/{Controllers,Services,Models}/Stocks
%%
%% Notas:
%%   - Subsistema pequeno. O gatilho de reposicao automatica (quando
%%     StockAtual <= StockMinimo) e invocado pelos servicos de Financas
%%     (FaturaService, VendaService), nao por este controller.
%%   - EncomendaStockController usa a rota base "api/Encomendas/stock/..."
%%     (nao "api/EncomendaStock"), razao pela qual o atributo e nomeado
%%     _encomendaService para clareza.

classDiagram
    direction LR

    class EncomendaStockController {
        <<controller>>
        -_encomendaService : IEncomendaStockService
        +EncomendaStockController(encomendaService : IEncomendaStockService)
        +Listar() Task~IActionResult~
        +Obter(id : int) Task~IActionResult~
        +Criar(dto : EncomendaStockCriacaoDto) Task~IActionResult~
        +Atualizar(id : int, dto : EncomendaStockAtualizacaoDto) Task~IActionResult~
        +Eliminar(id : int) Task~IActionResult~
    }

    class IEncomendaStockService {
        <<interface>>
        +GetEncomendasAsync() Task~IEnumerable~EncomendaStockDto~~
        +GetEncomendaPorIdAsync(id : int) Task~EncomendaStockDto?~
        +CriarEncomendaAsync(dto : EncomendaStockCriacaoDto) Task~EncomendaStockDto?~
        +AtualizarEncomendaAsync(id : int, dto : EncomendaStockAtualizacaoDto) Task~EncomendaStockDto?~
        +EliminarEncomendaAsync(id : int) Task~bool~
    }

    class EncomendaStockService {
        <<service>>
        -_httpClient : HttpClient
        +EncomendaStockService(httpClient : HttpClient)
        +GetEncomendasAsync() Task~IEnumerable~EncomendaStockDto~~
        +GetEncomendaPorIdAsync(id : int) Task~EncomendaStockDto?~
        +CriarEncomendaAsync(dto : EncomendaStockCriacaoDto) Task~EncomendaStockDto?~
        +AtualizarEncomendaAsync(id : int, dto : EncomendaStockAtualizacaoDto) Task~EncomendaStockDto?~
        +EliminarEncomendaAsync(id : int) Task~bool~
    }

    class EncomendaStockDto {
        <<DTO>>
        +EncomendaID : int
        +PecaEAN : string
        +Quantidade : int
        +Estado : string
        +DataPedido : string
        +OperadorRececaoNumero : string?
        +AdminValidadorNumero : string?
    }

    class EncomendaStockCriacaoDto {
        <<DTO>>
        +PecaEAN : string
        +Quantidade : int
        +AdminValidadorNumero : string?
    }

    class EncomendaStockAtualizacaoDto {
        <<DTO>>
        +Estado : string
        +OperadorRececaoNumero : string?
    }

    EncomendaStockService       ..|> IEncomendaStockService  : realiza
    EncomendaStockController    ..>  IEncomendaStockService  : injeta
    EncomendaStockController    ..>  EncomendaStockCriacaoDto
    EncomendaStockController    ..>  EncomendaStockAtualizacaoDto
    IEncomendaStockService      ..>  EncomendaStockDto
    IEncomendaStockService      ..>  EncomendaStockCriacaoDto
    IEncomendaStockService      ..>  EncomendaStockAtualizacaoDto
