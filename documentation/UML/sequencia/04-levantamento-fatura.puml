@startuml 04-levantamento-fatura
' =========================================================================
'  Cenário 4 — Operador regista levantamento, emite fatura e envia por email
'               (RF23 Levantamento + Faturação + Envio de Fatura)
' =========================================================================
autonumber "<b>[00]"
skinparam sequenceArrowThickness 1.2
skinparam maxMessageSize 220
title Levantamento de trotinete + emissão de fatura

actor      "Operador"  as Op
participant "OperadorPage" as UI
participant "ServicoController" as SC
participant "ServicoService" as SS
participant "FaturaService" as FS
participant "IPecaService" as PS
participant "IEncomendaStockService" as ES
participant "IEmailService" as Email
participant "Mongoose Data API" as API
participant "SMTP" as SMTP
actor      "Cliente" as C

Op -> UI : Seleciona trotinete pronta,\nescolhe método pagamento
UI -> SC : PUT /api/servicos/{id}/levantar\n(MetodoPagamento)
activate SC
SC -> SS : LevantarComFaturaAsync(id, metodo)
activate SS

SS -> API : GET /api/servicos/{id}
API --> SS : ServicoDto
SS -> API : GET /api/trotinetes/{numSerie}
API --> SS : TrotineteDto (ClienteNIF)

SS -> FS : CriarFaturaAsync(FaturaCriacaoDto)
activate FS
FS -> API : POST /api/faturas
API --> FS : FaturaDto

loop para cada ItemVenda (se aplicável)
    FS -> PS : GetPecaPorEanAsync(ean)
    PS -> API : GET /api/pecas/{ean}
    API --> PS : PecaDto
    FS -> FS : StockAtual -= Quantidade
    FS -> PS : AtualizarPecaAsync(ean, peca)
    PS -> API : PUT /api/pecas/{ean}
    API --> PS : ok
    FS -> FS : VerificarEReporStockAsync(peca)
    alt StockAtual ≤ StockMinimo\ne NÃO existe encomenda aberta
        FS -> ES : CriarEncomendaAsync(\nPecaEAN, PadraoReposicao)
        ES -> API : POST /api/encomendas-stock\n(Estado=PENDENTE)
        API --> ES : EncomendaStockDto
    end
end

FS -> Email : [Task.Run] EnviarFaturaAsync(\nemail, nome, num, total, metodo, desc)
activate Email
Email -> SMTP : SendAsync(MimeMessage)
SMTP --> C : Email com fatura
deactivate Email

FS --> SS : FaturaDto
deactivate FS

SS -> API : PUT /api/servicos/{id} (Estado="FECHADO")
API --> SS : ok
SS --> SC : LevantamentoComFaturaDto
deactivate SS
SC --> UI : 200 OK { fatura }
deactivate SC
UI --> Op : "Levantamento concluído"

@enduml
