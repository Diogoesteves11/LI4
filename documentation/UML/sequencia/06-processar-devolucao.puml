@startuml 06-processar-devolucao
' =========================================================================
'  Cenário 6 — Processar devolução de venda com emissão de nota de crédito
'              (RF24)
' =========================================================================
autonumber "<b>[00]"
skinparam sequenceArrowThickness 1.2
skinparam maxMessageSize 220
title Processar devolução de venda (RF24)

actor "Operador" as Op
participant "FaturaPage" as UI
participant "FaturaController" as FC
participant "FaturaService" as FS
participant "IVendaService" as VS
participant "IPecaService" as PS
participant "Mongoose Data API" as API

Op -> UI : Introduz número da fatura + motivo
UI -> FC : PUT /api/faturas/{num}/devolucao\n{ motivo }
activate FC
FC -> FS : ProcessarDevolucaoAsync(num, motivo)
activate FS
FS -> API : GET /api/faturas/{num}
API --> FS : FaturaDto
alt Fatura já devolvida
    FS --> FC : throw InvalidOperationException
    FC --> UI : 400 { mensagem }
else primeira devolução
    alt Fatura.VendaID != null
        FS -> VS : ObterVendaAsync(VendaID)
        VS -> API : GET /api/vendas/{id}
        API --> VS : Venda
        VS --> FS : Venda
        loop para cada ItemVenda
            FS -> PS : GetPecaPorEanAsync
            FS -> FS : StockAtual += Quantidade
            FS -> PS : AtualizarPecaAsync (restitui stock)
        end
    end
    FS -> API : PUT /api/faturas/{num}\n(Devolucoes[], NotaCredito)
    API --> FS : FaturaDto atualizada
    FS --> FC : FaturaDto
    FC --> UI : 200 OK
end
deactivate FS
deactivate FC
UI --> Op : "Devolução processada"

@enduml
