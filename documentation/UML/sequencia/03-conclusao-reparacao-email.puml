@startuml 03-conclusao-reparacao-email
' =========================================================================
'  Cenário 3 — Mecânico conclui reparação e cliente é notificado por email
'              (RF17 Guia Reparação + RF19 SMTP on "Pronto")
' =========================================================================
autonumber "<b>[00]"
skinparam sequenceArrowThickness 1.2
skinparam maxMessageSize 220
title Conclusão de reparação + notificação SMTP (trotinete pronta)

actor      "Mecânico" as M
participant "GuiaReparacaoPage" as UI
participant "ServicoController" as Ctrl
participant "ServicoService" as Svc
participant "Mongoose Data API" as API
participant "IClienteService" as CSvc
participant "IEmailService\n(MailKit)" as Email
participant "SMTP" as SMTP
actor      "Cliente" as C

M  -> UI  : Preenche intervenções e peças usadas
UI -> Ctrl : PUT /api/servicos/{id}\n{ Estado:"CONCLUIDO", HistoricoIntervencoes:[...] }
activate Ctrl
Ctrl -> Svc : AtualizarServicoAsync(id, dto)
activate Svc
Svc -> API : PUT /api/servicos/{id}
API --> Svc : ServicoDto (atualizado)

Svc -> Svc : Estado == "CONCLUIDO" ?\n→ fire-and-forget Task.Run

note over Svc
  **Background — não bloqueia o PUT**
end note

par Notificação assíncrona
    Svc -> API : GET /api/trotinetes/{numSerie}
    API --> Svc : TrotineteDto (ClienteNIF)
    Svc -> CSvc : ObterPorNifAsync(nif)
    CSvc -> API : GET /api/clientes/{nif}
    API --> CSvc : ClienteDto (Nome, Email)
    CSvc --> Svc : ClienteDto
    Svc -> Email : NotificarTrotineteProntaAsync(\nemail, nome, ServicoID, NS, Preço)
    Email -> Email : monta HTML (template "Pronto")
    Email -> SMTP : SendAsync(MimeMessage)
    SMTP --> C : Email "A sua trotinete está pronta"
else Resposta imediata
    Svc --> Ctrl : ServicoDto
    Ctrl --> UI : 200 OK
end
deactivate Svc
deactivate Ctrl
UI --> M : "Reparação concluída"

@enduml
