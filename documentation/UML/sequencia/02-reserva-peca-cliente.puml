@startuml 02-reserva-peca-cliente
' =========================================================================
'  Cenário 2 — Cliente reserva peça (com validação de stock) (RF4)
' =========================================================================
autonumber "<b>[00]"
skinparam sequenceArrowThickness 1.2
skinparam maxMessageSize 220
title Reserva de peças por cliente (com validação de stock)

actor "Cliente" as C
participant "React SPA\n(CatalogoPecasPage)" as UI
participant "EncomendaClienteController" as Ctrl
participant "EncomendaClienteService" as Svc
participant "IPecaService" as PSvc
participant "Mongoose Data API" as API

C  -> UI : Adiciona peças ao carrinho\n(+/- quantidades)
UI -> UI : Verifica qtd ≤ StockAtual\n(disable no botão +)
C  -> UI : Clica "Confirmar Reserva"
UI -> Ctrl : POST /api/encomendas-cliente\n(JWT + Itens[])
activate Ctrl
Ctrl -> Ctrl : [Authorize] → clienteNIF (JWT claim "id")
Ctrl -> Svc : CriarEncomendaAsync(nif, dto)
activate Svc

group Validação transacional de stock
    Svc -> API : GET /api/encomendas-cliente\n?estado=PRONTO PARA LEVANTAMENTO
    API --> Svc : lista encomendas pendentes
    loop para cada EAN pedido
        Svc -> PSvc : GetPecaPorEanAsync(ean)
        PSvc -> API : GET /api/pecas/{ean}
        API --> PSvc : PecaDto
        PSvc --> Svc : peca
        Svc -> Svc : disponivel = StockAtual - jaReservado
        alt pedido > disponivel
            Svc --> Ctrl : throw InvalidOperationException
            Ctrl --> UI : 400 { mensagem: "Stock insuficiente..." }
            UI --> C : alert("Stock insuficiente")
        end
    end
end

Svc -> Svc : total = Σ PrecoUnit × Qtd
Svc -> API : POST /api/encomendas-cliente
API --> Svc : EncomendaCliente (Estado=PRONTO PARA LEVANTAMENTO)
Svc --> Ctrl : EncomendaCliente
deactivate Svc
Ctrl --> UI : 201 Created
deactivate Ctrl
UI --> C : Toast "Reserva confirmada!"

@enduml
