                      </td>
                      <td className="px-6 py-4">
                        <span className={`inline-flex items-center gap-1 px-3 py-1 rounded-full text-[10px] font-black border ${CATEGORIA_COLORS[peca.Categoria] ?? CATEGORIA_COLORS.OUTROS}`}>
                          <Layers className="w-3 h-3" />
                          {peca.Categoria}
