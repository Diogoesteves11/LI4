                <p className="text-slate-500 leading-relaxed font-medium max-w-sm">
                  {feature.description}
                </p>

                {/* Subtle Divider (Mobile only) */}
                {index !== features.length - 1 && (
                  <div className="w-12 h-1 bg-slate-100 mt-12 md:hidden"></div>
                )}
              </div>
            );
          })}
        </div>
      </div>
    </section>
  );
}
