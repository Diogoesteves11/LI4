                    ${selectedOrder.status === 'pendente' ? 'bg-amber-100 text-amber-700' : 
                      selectedOrder.status === 'transito' ? 'bg-blue-100 text-blue-700' : 
                      'bg-emerald-100 text-emerald-700'}`}>
