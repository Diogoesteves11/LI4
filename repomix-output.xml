@startuml 01-subsistema-utilizadores
' =========================================================================
'  Subsistema :: Utilizadores & Autenticação
'  Engloba: Cliente, Funcionario, login/registo (JWT) e edição de perfil
' =========================================================================
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
hide empty members
title Subsistema de Utilizadores & Autenticação

' ------------------------------------------------------------------------
'  Domínio
' ------------------------------------------------------------------------
package "Domínio" <<Rectangle>> {

    class Cliente {
        + NIF : string <<PK>>
        + Nome : string
        + Telefone : string
        + Email : string
        + Morada : string
        - PasswordHash : string
    }

    class Funcionario {
        + NumeroMecanografico : string <<PK>>
        + Nome : string
        + Email : string
        + Contacto : string
        + Cargo : Cargo
        + Especialidade : string [0..1]
        + Ativo : boolean
        - PasswordHash : string
    }

    enum Cargo {
        ADMINISTRADOR
        OPERADOR_LOJA
        MECANICO
    }

    Funcionario ..> Cargo : <<enum>>
}

' ------------------------------------------------------------------------
'  DTOs de transporte
' ------------------------------------------------------------------------
package "DTOs" <<Rectangle>> {
    class ClienteLoginDto     { + Email : string\n+ Password : string }
    class ClienteRegistoDto   { + NIF, Nome, Email,\n  Telefone, Morada, Password }
    class FuncionarioLoginDto { + NumeroMecanografico\n+ Password }
    class FuncionarioCriacaoDto      <<DTO>>
    class FuncionarioAtualizacaoDto  <<DTO>>
}

' ------------------------------------------------------------------------
'  Serviços
' ------------------------------------------------------------------------
package "Services" <<Frame>> {

    interface IAuthService {
        +LoginFuncionarioAsync(FuncionarioLoginDto) : Task<string?>
        +LoginClienteAsync(ClienteLoginDto) : Task<string?>
        +RegistarClienteAsync(ClienteRegistoDto) : Task<bool>
    }

    interface IClienteService {
        +ObterPorNifAsync(nif) : Task<Cliente?>
    }

    interface IFuncionarioService {
        +CriarFuncionarioAsync(dto) : Task<Funcionario?>
        +ListarFuncionariosAsync() : Task<IEnumerable<Funcionario>>
        +ObterFuncionarioPorNumeroAsync(num) : Task<Funcionario?>
        +AtualizarFuncionarioAsync(num, dto) : Task<Funcionario?>
    }

    class AuthService         implements IAuthService
    class ClienteService      implements IClienteService
    class FuncionarioService  implements IFuncionarioService
}

' ------------------------------------------------------------------------
'  Controllers REST
' ------------------------------------------------------------------------
package "Controllers" <<Frame>> {
    class AuthController         <<Controller>> {
        +LoginCliente()
        +LoginFuncionario()
        +RegistarCliente()
    }
    class ClienteController      <<Controller>> {
        +ObterPerfil()
        +AtualizarPerfil()
    }
    class FuncionarioController  <<Controller>> {
        +Listar() +Criar() +Atualizar() +Obter()
    }
}

' ------------------------------------------------------------------------
'  Relações
' ------------------------------------------------------------------------
AuthController         ..> IAuthService
ClienteController      ..> IClienteService
FuncionarioController  ..> IFuncionarioService

AuthService          ..> Cliente
AuthService          ..> Funcionario
ClienteService       ..> Cliente
FuncionarioService   ..> Funcionario

AuthService     ..> ClienteLoginDto
AuthService     ..> ClienteRegistoDto
AuthService     ..> FuncionarioLoginDto
FuncionarioService ..> FuncionarioCriacaoDto
FuncionarioService ..> FuncionarioAtualizacaoDto

note right of IClienteService
  Consumido também pelos subsistemas
  de Serviços e Finanças para obter
  o email do cliente (notificações).
end note

@enduml
</file>

<file path="documentation/UML/classes/02-subsistema-servicos.puml">
@startuml 02-subsistema-servicos
' =========================================================================
'  Subsistema :: Serviços de Reparação
'  Engloba: Trotinete, IntervencaoCatalogo, Servico, IntervencaoRealizada,
'           PecaUtilizada, Agenda + serviços e controllers associados
' =========================================================================
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
hide empty members
title Subsistema de Serviços de Reparação

' ------------------------------------------------------------------------
'  Domínio
' ------------------------------------------------------------------------
package "Domínio" <<Rectangle>> {

    class Trotinete {
        + NumeroSerie : string <<PK>>
        + Marca : string
        + Modelo : string
        + ClienteNIF : string <<FK>>
        + EmServico : boolean
    }

    class IntervencaoCatalogo {
        + IntervencaoID : int <<PK>>
        + Descricao : string
        + PrecoFixoMaoDeObra : decimal
        + Especialidade : string [0..1]
    }

    class Servico {
        + ServicoID : int <<PK>>
        + TrotineteNumSerie : string <<FK>>
        + Estado : EstadoServico
        + DataAgendamento : DateTime
        + DescricaoDiagnostico : string [0..1]
        + FeedbackCliente : string [0..1]
        + DataConclusao : DateTime [0..1]
        + Preco : decimal
    }

    enum EstadoServico {
        AGENDADO
        EM_DIAGNOSTICO
        ORCAMENTADO
        EM_REPARACAO
        CONCLUIDO
        FECHADO
    }

    class IntervencaoRealizada {
