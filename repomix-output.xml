                    <Clock className="h-4 w-4 text-slate-400" />
                    <span className="font-bold text-slate-900">{repair.scheduledTime}</span>
                    <span className="text-xs text-slate-500">({repair.estimatedDuration} min)</span>
                  </div>
                  
