              <Link 
                to="/auth" 
                state={{ mode: 'register' }} 
                className="bg-safety-orange hover:bg-orange-600 text-white px-6 py-2.5 rounded-lg font-bold text-sm shadow-md hover:shadow-orange-500/20 transition-all active:scale-95"
