<file path="documentation/UML/classes/03-subsistema-financas.puml">
@startuml 03-subsistema-financas
' =========================================================================
'  Subsistema :: Finanças
'  Engloba: Fatura, Devolucao, NotaCredito, Venda, ItemVenda,
'           EncomendaCliente, Promocao, Estatisticas
' =========================================================================
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
hide empty members
title Subsistema de Finanças

' ------------------------------------------------------------------------
'  Domínio
' ------------------------------------------------------------------------
package "Domínio" <<Rectangle>> {

    class Fatura {
        + NumeroFatura : string <<PK>>
        + ClienteNIF : string <<FK>>
        + ServicoID : int [0..1] <<FK>>
        + VendaID : int [0..1] <<FK>>
        + ValorTotal : decimal
        + MetodoPagamento : string
        + DataEmissao : DateTime
    }

    class Devolucao {
        + DevolucaoID : string
        + DataDevolucao : DateTime
        + Motivo : string
    }

    class NotaCredito {
        + ValorCreditado : decimal
    }

    class Venda {
        + VendaID : int <<PK>>
        + OperadorNumero : string <<FK>>
        + DataVenda : DateTime
        + Total : decimal
    }

    class ItemVenda {
        + PecaEAN : string <<FK>>
        + Quantidade : int
    }

    class EncomendaCliente {
        + EncomendaClienteID : int <<PK>>
        + ClienteNIF : string <<FK>>
        + DataEncomenda : DateTime
        + Estado : EstadoEncomendaCliente
        + Total : decimal
        + FaturaNumero : int [0..1]
    }

    class ItemEncomenda {
        + PecaEAN : string <<FK>>
        + Quantidade : int
    }

    enum EstadoEncomendaCliente {
        PRONTO_PARA_LEVANTAMENTO
        LEVANTADA
        CANCELADA
    }

    class Promocao {
        + PromocaoID : int <<PK>>
        + Descricao : string
        + PercentagemDesconto : int
        + DataInicio : DateTime
        + DataFim : DateTime
        + AdministradorNumero : string <<FK>>
        + Ativa : boolean
    }

    class Estatistica {
        + Data : DateTime
        + TotalVendas : decimal
        + TotalServicos : decimal
        + NumFaturas : int
    }

    ' Referências a outros subsistemas
    class Cliente      <<external>>
    class Funcionario  <<external>>
    class Peca         <<external>>
    class Servico      <<external>>

    EncomendaCliente ..> EstadoEncomendaCliente

    Cliente "1" --> "0..*" Fatura           : destinatário >
    Cliente "1" --> "0..*" EncomendaCliente : reserva >

    Fatura "1" --> "0..1" Servico
    Fatura "1" --> "0..1" Venda
    Fatura "1" *-- "0..*" Devolucao
    Devolucao "1" *-- "0..1" NotaCredito

    Venda "1" *-- "1..*" ItemVenda
    ItemVenda "*" --> "1" Peca
    Venda "*" --> "1" Funcionario : operador >

    EncomendaCliente "1" *-- "1..*" ItemEncomenda
    ItemEncomenda "*" --> "1" Peca

    Promocao "*" --> "0..*" Peca        : aplicável a >
    Promocao "*" --> "1" Funcionario    : criada por >
}

' ------------------------------------------------------------------------
'  DTOs de transporte
' ------------------------------------------------------------------------
package "DTOs" <<Rectangle>> {
    class FaturaCriacaoDto            <<DTO>>
    class DevolucaoCriacaoDto         <<DTO>>
    class CheckoutVendaDiretaDto      <<DTO>>
    class VendaComFaturaDto           <<DTO>>
    class ItemVendaCriacaoDto         <<DTO>>
    class EncomendaClienteCriacaoDto  <<DTO>>
    class ItemEncomendaCriacaoDto     <<DTO>>
    class PecaReservadaDto            <<DTO>>
    class LevantamentoEncomendaDto    <<DTO>>
    class PromocaoCriacaoDto          <<DTO>>
}

' ------------------------------------------------------------------------
'  Serviços
' ------------------------------------------------------------------------
package "Services" <<Frame>> {

    interface IFaturaService {
        +GetFaturasAsync() : Task<IEnumerable<Fatura>>
        +GetFaturasCliente(id) : Task<IEnumerable<Fatura>>
        +GetFaturaPorNumeroAsync(num) : Task<Fatura?>
        +CriarFaturaAsync(dto) : Task<Fatura?>
        +EliminarFaturaAsync(num) : Task<bool>
        +ProcessarDevolucaoAsync(num, motivo) : Task<Fatura?>
    }

    interface IVendaService {
        +ListarVendasAsync() : Task<IEnumerable<Venda>>
        +ObterVendaAsync(id) : Task<Venda?>
        +RegistarVendaDiretaAsync(op, dto) : Task<VendaComFaturaDto?>
    }

    interface IEncomendaClienteService {
        +CriarEncomendaAsync(nif, dto) : Task<EncomendaCliente?>
        +ListarEncomendasClienteAsync(nif) : Task<IEnumerable<EncomendaCliente>>
        +ListarProntasParaLevantamentoAsync() : Task<IEnumerable<PecaReservadaDto>>
        +MarcarComoLevantadaAsync(id) : Task<bool>
        +LevantarComFaturaAsync(id, metodo) : Task<Fatura?>
    }

    interface IPromocaoService {
        +GetPromocoesAsync() : Task<IEnumerable<Promocao>>
        +GetPromocaoPorIdAsync(id) : Task<Promocao?>
        +CriarPromocaoAsync(dto) : Task<Promocao?>
        +AtualizarPromocaoAsync(id, dto) : Task<Promocao?>
        +AlterarEstadoAsync(id, ativa) : Task<Promocao?>
        +EliminarPromocaoAsync(id) : Task<bool>
    }

    interface IEstatisticasService {
        +GetEstatisticaDiaAsync(d) : Task<Estatistica>
        +GetIntervaloEstatisticaAsync(i, f) : Task<Estatistica>
        +GetEstatisticasAsync() : Task<Estatistica>
    }

    ' Serviços de outros subsistemas usados via DI
    interface IPecaService             <<external>>
    interface IEncomendaStockService   <<external>>
    interface IClienteService          <<external>>
    interface IEmailService            <<external>>

    class FaturaService           implements IFaturaService
    class VendaService            implements IVendaService
    class EncomendaClienteService implements IEncomendaClienteService
    class PromocaoService         implements IPromocaoService
    class EstatisticasService     implements IEstatisticasService
}

' Dependências reais entre serviços
FaturaService           ..> IPecaService
FaturaService           ..> IVendaService
FaturaService           ..> IEncomendaStockService
FaturaService           ..> IClienteService
FaturaService           ..> IEmailService

VendaService            ..> IFaturaService
VendaService            ..> IPecaService

EncomendaClienteService ..> IFaturaService
EncomendaClienteService ..> IPecaService

' ------------------------------------------------------------------------
'  Controllers REST
' ------------------------------------------------------------------------
package "Controllers" <<Frame>> {
    class FaturaController           <<Controller>> {
        +Listar()
        +ObterPorNumero()
        +Criar()
        +ProcessarDevolucao()
    }
    class VendaController            <<Controller>> {
        +Listar()
        +RegistarVendaDireta()
    }
    class EncomendaClienteController <<Controller>> {
        +ListarMinhas()
        +Criar()
        +ListarProntas()
        +Levantar()
    }
    class PromocaoController         <<Controller>>
    class EstatisticasController     <<Controller>>
}

FaturaController           ..> IFaturaService
VendaController            ..> IVendaService
EncomendaClienteController ..> IEncomendaClienteService
PromocaoController         ..> IPromocaoService
EstatisticasController     ..> IEstatisticasService

' DTOs
FaturaService            ..> FaturaCriacaoDto
FaturaService            ..> DevolucaoCriacaoDto
VendaService             ..> CheckoutVendaDiretaDto
VendaService             ..> VendaComFaturaDto
VendaService             ..> ItemVendaCriacaoDto
EncomendaClienteService  ..> EncomendaClienteCriacaoDto
EncomendaClienteService  ..> ItemEncomendaCriacaoDto
EncomendaClienteService  ..> PecaReservadaDto
EncomendaClienteService  ..> LevantamentoEncomendaDto
PromocaoService          ..> PromocaoCriacaoDto

note right of FaturaService
  Ao criar uma fatura, abate stock e,
  se StockAtual ≤ StockMinimo, delega
  ao subsistema de Stocks a criação
  automática de uma EncomendaStock.
end note

@enduml
</file>

