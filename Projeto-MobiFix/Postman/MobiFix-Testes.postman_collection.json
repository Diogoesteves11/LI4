					"name": "1. Criar Funcionário",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code deve ser 201 Created\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"if (pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set(\"funcionario_id\", jsonData.NumeroMecanografico);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"NumeroMecanografico\": \"TESTE001\",\n    \"Nome\": \"Diogo Teste\",\n    \"Email\": \"diogo.teste@mobifix.pt\",\n    \"Contacto\": \"910000000\",\n    \"Cargo\": \"Mecanico\",\n    \"PasswordHash\": \"hash_super_secreta_123\",\n    \"Especialidade\": \"Baterias\",\n    \"Ativo\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/funcionarios",
