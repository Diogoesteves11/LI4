# ─── Credenciais e Segredos (PREENCHER COM DADOS LOCAIS) ───
DB_PASSWORD=<INSERIR_A_TUA_PASSWORD_AQUI>
JWT_SECRET=<INSERIR_UMA_CHAVE_SECRETA_AQUI_COM_PELO_MENOS_32_CARATERES>

# ─── Data API Builder (DAB) ───
# Se testares fora do Docker, a connection string deve usar a mesma password acima
DAB_CONNECTION_STRING="Server=localhost;Database=MobiFix;User Id=sa;Password=<INSERIR_A_TUA_PASSWORD_AQUI>;TrustServerCertificate=True;"
DAB_PORT=5000
DAB_URL="http://localhost:5000"
DabSettings__BaseUrl="http://localhost:5000"

# ─── API Lógica de Negócio (LN) ───
LN_API_PORT=5001
LN_API_URL="http://localhost:5001"